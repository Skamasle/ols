[Unit]
Description=Skamasle OLS Agent
After=network.target lsws.service

[Service]
Type=simple
ExecStart=/usr/local/bin/skamasle-ols-agent
ExecReload=/bin/kill -HUP $MAINPID

# permissive: validate and reload on review/blocked findings, while warning.
# strict: keep review/blocked findings fail-closed and require manual action.
Environment=SKAMASLE_OLS_RELOAD_POLICY=permissive

Restart=on-failure
RestartSec=5s

# Run as root so it can watch all vhost directories
User=root
Group=root

# Resource limits
MemoryMax=64M
LimitNOFILE=65535

# Logging to syslog (daemon facility)
StandardOutput=null
StandardError=journal
SyslogIdentifier=skamasle-ols-agent

[Install]
WantedBy=multi-user.target
